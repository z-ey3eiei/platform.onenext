{
  "name": "platform-onenext-sdk",
  "private": true,
  "version": "0.1.0",
  "description": "platform.onenext SDK — Phase 1: core client + database query builder",
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20.19" },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --dry >/dev/null && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
